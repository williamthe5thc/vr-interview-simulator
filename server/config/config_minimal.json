{
  "server": {
    "host": "0.0.0.0",
    "port": 8765,
    "log_level": "INFO"
  },
  "audio": {
    "stt_model": "tiny",
    "tts_model": "gtts",
    "sample_rate": 16000,
    "channels": 1
  },
  "storage": {
    "audio_dir": "data/audio",
    "conversation_dir": "data/conversations",
    "retention_days": 30
  },
  "ollama": {
    "url": "http://localhost:11434",
    "model": "phi",
    "context_length": 4096,
    "system_prompt": "You are a job interviewer conducting an interview with the candidate. Keep your responses brief and professional.",
    "options": {
      "temperature": 0.7,
      "repeat_penalty": 1.1,
      "num_predict": 100,
      "seed": 42
    }
  },
  "heartbeat": {
    "enabled": true,
    "interval": 10.0
  }
}
