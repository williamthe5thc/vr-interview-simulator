  "heartbeat": {
    "enabled": true,
    "interval": 5.0
  },
  "alltalk": {
    "url": "http://127.0.0.1:7851",
    "voice": "female_06.wav",
    "format": "wav",
    "retries": 3,
    "timeout": 60,
    "direct_api_timeout": 60,
    "alltalk_dir": "PATH_TO_ALLTALK/alltalk_tts",
    "default_language": "en"
  },
  "engine": "kokoro"
