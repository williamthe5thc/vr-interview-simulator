{
  "server": {
    "host": "0.0.0.0",
    "port": 8765,
    "log_level": "INFO"
  },
  "audio": {
    "stt_model": "small",
    "device": "cuda",
    "tts_model": "en",
    "sample_rate": 16000,
    "channels": 1,
    "stt_remote_url": "http://127.0.0.1:8770"
  },
  "storage": {
    "audio_dir": "data/audio",
    "conversation_dir": "data/conversations",
