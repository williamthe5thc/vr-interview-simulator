{
  "__comment": "Copy to config.json (git-ignored) and edit. No API keys here: they live in user environment variables (VRSIM_ANTHROPIC_API_KEY). access: require_access_code=true needs your own codes (tools/access_codes.py, see docs/ACCESS_CODES.md); add your tunnel/proxy host to trusted_proxies; cf_team_domain is your Cloudflare Access team (e.g. YOUR_TEAM.cloudflareaccess.com), empty = no web session skips the code.",
  "server": {
    "host": "0.0.0.0",
    "port": 8765,
    "log_level": "INFO"
  },
  "audio": {
    "stt_model": "small",
    "device": "cuda",
    "tts_model": "en",
    "sample_rate": 16000,
    "channels": 1,
    "stt_remote_url": "http://127.0.0.1:8770"
  },
  "storage": {
    "audio_dir": "data/audio",
    "conversation_dir": "data/conversations",
    "retention_days": 30
  },
  "ollama": {
    "url": "http://127.0.0.1:11434",
    "model": "qwen2.5:7b-instruct",
    "context_length": 8192,
    "scenario_type": "interview",
    "options": {
      "temperature": 0.8,
      "top_p": 0.9,
      "top_k": 40,
      "repeat_penalty": 1.1,
      "num_predict": 160,
      "seed": null,
      "timeout": 60
    },
    "stream_reply": true
  },
  "heartbeat": {
    "enabled": true,
    "interval": 5.0
  },
  "alltalk": {
    "url": "http://127.0.0.1:7851",
    "voice": "female_06.wav",
    "format": "wav",
    "retries": 3,
    "timeout": 60,
    "direct_api_timeout": 60,
    "alltalk_dir": "PATH_TO_ALLTALK/alltalk_tts",
    "default_language": "en"
  },
  "engine": "kokoro",
  "access": {
    "require_access_code": true,
    "cf_team_domain": "",
    "cf_access_aud": [],
    "quest_daily_usd_cap": 1.0,
    "code_usd_per_day": 0.25,
    "trusted_proxies": [
      "127.0.0.1",
      "::1"
    ]
  },
  "web": {
    "allowed_origins": [
      "https://YOUR_WEB_HOST"
    ],
    "max_sessions": 2,
    "max_turns_per_session": 12,
    "session_usd_cap": 0.05,
    "daily_usd_cap": 2.0,
    "interviews_per_hour_per_identity": 3,
    "export": "save",
    "heartbeat_seconds": 25,
    "coach": "haiku",
    "max_text_chars": 1500,
    "max_text_words": 250
  }
}